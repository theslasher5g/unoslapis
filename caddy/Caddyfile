# Caddy holt sich für jede hier gelistete Domain automatisch ein
# Let's-Encrypt-Zertifikat. Voraussetzung: DNS-A-Record zeigt auf den VPS
# und Port 80 + 443 sind offen.
#
# Hinweis: Scheitert eine Anfrage (z.B. fehlender DNS-Eintrag), testet Caddy
# die nächsten Versuche gegen "acme-staging". Das ist normal und gewollt.

{
	# Optional: E-Mail für Let's-Encrypt-Benachrichtigungen
	# email deine@mail.ch
}

(common) {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		-Server
	}
}

# Alle statischen Seiten
{$DOMAIN}, dating.{$DOMAIN}, overwatch.{$DOMAIN}, b-day.{$DOMAIN}, goon.{$DOMAIN}, girlfriend.{$DOMAIN}, linkedin.{$DOMAIN}, nofap.{$DOMAIN}, touchgrass.{$DOMAIN}, waifu.{$DOMAIN}, quotes.{$DOMAIN}, news.{$DOMAIN}, excuses.{$DOMAIN}, horoskop.{$DOMAIN}, merch.{$DOMAIN}, discord.{$DOMAIN}, wordle.{$DOMAIN}, tinder.{$DOMAIN} {
	import common
	reverse_proxy web:80
}

# Gästebuch: Seite von nginx, /api/* vom Gästebuch-Backend
guestbook.{$DOMAIN} {
	import common
	handle /api/* {
		request_body {
			max_size 8KB
		}
		reverse_proxy guestbook:3000
	}
	handle {
		reverse_proxy web:80
	}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

# Neue Subdomain? 1) hier oben in die Liste eintragen
#                 2) in nginx/default.conf in die map eintragen
#                 3) Ordner sites/<name>/index.html anlegen
#                 4) DNS-Eintrag anlegen, dann: docker compose restart
